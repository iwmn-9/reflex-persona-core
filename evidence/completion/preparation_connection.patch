+"""Actual lifecycle, owner isolation and terminal restart of the combined owner."""
+import copy,unittest
+from reflex.core import digest
+from integrated_probe import build,game_for,actual_after
+
+class PreparationOwnerTests(unittest.TestCase):
+    def test_actual_feedback_and_save_are_one_owner_boundary(self):
+        spec=dict(id='lifecycle',length=1,profile=3,turns=3)
+        game=game_for(spec);world=game.start();owner=build(game);template=build(game)
+        initial=owner.checkpoint(world)
+        result=owner.decide(world)
+        with self.assertRaises(ValueError):owner.checkpoint(world)
+        key=result['decision']['action_id'];after,flow=actual_after(game,world,key,spec)
+        feedback=game.feedback(world,after,key,result['context'],flow)
+        with self.assertRaises(ValueError):owner.resolve(result['ticket'],feedback,world)
+        # A rejected boundary retains the same pending ticket; valid feedback still works.
+        owner.resolve(result['ticket'],feedback,after)
+        saved=owner.checkpoint(after);restored=template.restored(after,saved)
+        self.assertEqual(restored.checkpoint(after),saved)
+        bad=copy.deepcopy(saved);bad['payload']['milestone']['intention']['last_tick']+=1
+        bad['sha256']=digest(bad['payload'])
+        with self.assertRaises(ValueError):template.restored(after,bad)
+        self.assertEqual(template.checkpoint(world),initial)
+        while not game.terminal(after):
+            world=after;result=restored.decide(world);key=result['decision']['action_id']
+            after,flow=actual_after(game,world,key,spec)
+            restored.resolve(result['ticket'],game.feedback(world,after,key,result['context'],flow),after)
+            restored=template.restored(after,restored.checkpoint(after))
+        self.assertEqual(restored.actor.last_tick,spec['turns']-1)
+        with self.assertRaises(ValueError):restored.decide(after)
+
+    def test_failed_planner_does_not_modify_actual_owner(self):
+        game=game_for(dict(id='failed',length=1,profile=0,turns=3))
+        owner=build(game);world=game.start();before=owner.checkpoint(world)
+        def broken(world):raise ValueError('host model failed')
+        owner.options['events']=broken
+        with self.assertRaises((ValueError,TypeError)):owner.decide(world)
+        owner.options['events']=game.events
+        self.assertEqual(owner.checkpoint(world),before)
+
+    def test_wrong_owner_public_boundary_is_rejected_before_commit(self):
+        spec=dict(id='foreign-boundary',length=1,profile=0,turns=3)
+        game=game_for(spec);world=game.start();owner=build(game)
+        original=owner.observe
+        def observe(world,state):
+            c=original(world,state)
+            if world.get('foreign_owner'):c['seed']+=1
+            return c
+        owner.observe=observe;owner.options['observe']=observe
+        result=owner.decide(world);key=result['decision']['action_id']
+        after,flow=actual_after(game,world,key,spec)
+        feedback=game.feedback(world,after,key,result['context'],flow)
+        wrong=copy.deepcopy(after);wrong['foreign_owner']=True
+        with self.assertRaises(ValueError):owner.resolve(result['ticket'],feedback,wrong)
+        owner.resolve(result['ticket'],feedback,after)
+        self.assertEqual(owner.actor.last_tick,0)
+
+if __name__=='__main__':unittest.main()
