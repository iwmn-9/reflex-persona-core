+"""Finite diagnosis of composing different public preparation actions.
+
+No new controller and no adoption claim. Compare two existing planners,
+including actual learning after every selected action and terminal results.
+"""
+import argparse,copy,json,time
+from pathlib import Path
+from reflex.core import digest,character_key
+from reflex.examples import effect
+from reflex.laboratory import PROFILES
+from reflex.closed_loop import ClosedLoop,Transition,TreeBudget
+from reflex.decision_loop import DecisionLoop
+from reflex.model_observer import resolve_feedback
+from tools.preparation_world import DelayedYield
+from tools.run_adverse_recovery import decide
+from tools.run_owned_value import cumulative_basis
+
+class PublicSequence(DelayedYield):
+    def __init__(self,length,profile):
+        super().__init__(length,payout=14.,turns=2*length+1,profile=PROFILES[profile])
+        self.model_id=digest(['public-two-preparation-stages-v2',length,self.turns,self.payout])
+    def start(self):
+        w=super().start();w.update(first=0,second=0);return w
+    def keys(self,w):return () if self.terminal(w) else ('u','v','w')
+    def transition(self,w,key,symbol):
+        # The inherited observation builder probes three identical conditional
+        # slots; the deterministic public event stream itself contains only 0.
+        if key not in self.keys(w) or symbol not in ('0','1','2'):raise ValueError('public legal deterministic transition required')
+        after=copy.deepcopy(w);after.update(tick=w['tick']+1,signal='0',last=key)
+        if key=='u':
+            after['cash']-=1;after['first']=min(self.delay,w['first']+1)
+        elif key=='v':
+            after['cash']-=1
+            if w['first']==self.delay:after['second']=min(self.delay,w['second']+1)
+        elif w['second']==self.delay:
+            after['cash']+=w['payout'];after.update(first=0,second=0)
+        else:after['cash']+=1
+        gain=max(-1.,min(1.,(after['cash']-w['cash'])/12.))
+        return after,effect(gain,needs={'growth':gain,'safety':0.},values={'achievement':gain})
+
+def choose_full(actor,g,world):
+    request=g.request(g.context(world,actor.state));remaining=g.turns-world['tick']
+    transition=lambda w,k:[Transition(1.,*g.transition(w,k,'0'))]
+    model=ClosedLoop(observe=g.context,transitions=transition,terminal=g.terminal,
+        assess=lambda w:g.goal(w).record(),record=lambda w:copy.deepcopy(w),
+        request_for=g.request,feedback=g.feedback,unit='owner-decisions',target=g.target,
+        model_id=g.model_id,budget=TreeBudget(horizon=remaining,nodes=10000,outcomes=256),
+        owner_transitions=lambda w,k,a,c:transition(w,k),future_choices='planned',
+        opportunity_regret=True,relative_objective=True,cumulative_preference=cumulative_basis(g,True))
+    model.source_owner=digest(actor.record());capture={}
+    result=DecisionLoop.decide_batch([(actor,request)],False,model.planner(actor,request,world,captured=capture))[0]
+    assert capture['audit']['complete'] and result['deliberation']['adopted']
+    return result,dict(nodes=capture['audit']['nodes'],forecast_purpose=capture['node']['forecast'].purpose)
+
+def run(length,profile,arm):
+    game=PublicSequence(length,profile);world=game.start();actor=game.actor(game.context(world),learning='segmented')
+    axis=character_key(game.context(world));trace=[];start=time.monotonic()
+    while not game.terminal(world):
+        before=actor.record();detached=copy.deepcopy(actor)
+        if arm=='shared':
+            result,capture=decide(actor,game,world,'expected',continuation_scope='shared')
+            diagnostic=dict(simulated_steps=capture['simulated_steps'],forecast_purpose=capture['forecast'].purpose)
+        else:result,diagnostic=choose_full(actor,game,world)
+        key=result['decision']['action_id'];after,flow=game.transition(world,key,'0')
+        feedback=game.feedback(world,after,key,result['context'],flow)
+        resolve_feedback(actor,result['ticket'],feedback)
+        forced=DecisionLoop.decide_batch([(detached,game.request(game.context(world,detached.state)))],False,_counterfactual_roots=(key,))[0]
+        resolve_feedback(detached,forced['ticket'],feedback)
+        assert actor.record()==detached.record() and character_key(game.context(after))==axis
+        saved=json.loads(json.dumps(actor.record()));actor=DecisionLoop.from_record(result['context'],saved,predictor=actor.predictor)
+        assert saved==actor.record()
+        trace.append(dict(before=world,action=key,after=after,source_owner=digest(before),owner=digest(saved),diagnostic=diagnostic))
+        world=after
+    return dict(length=length,profile=profile,arm=arm,complete=True,trace=trace,score=game.goal(world).value,
+        gain=world['cash']-game.start()['cash'],final=world,final_owner=actor.record(),seconds=time.monotonic()-start,
+        limit='Known finite deterministic diagnostic. Different planning budgets, not normalized persona regret or long-world adoption.')
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser();p.add_argument('--length',type=int,required=True);p.add_argument('--profile',type=int,required=True)
+    p.add_argument('--arm',choices=('shared','full'),required=True);p.add_argument('--output',required=True);a=p.parse_args()
+    row=run(a.length,a.profile,a.arm);out=Path(a.output);out.mkdir(parents=True,exist_ok=True)
+    (out/f'{a.length}-{a.profile}-{a.arm}.json').write_text(json.dumps(row,sort_keys=True))
+    print(json.dumps({k:row[k] for k in ('length','profile','arm','complete','gain','seconds')}),flush=True)
