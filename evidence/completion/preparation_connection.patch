+"""Regression: unsupported maximum-purpose continuation must not disable others."""
+import unittest
+import numpy as np
+from milestone_supported import SupportedArrivalPreference
+
+
+class SupportedArrivalTests(unittest.TestCase):
+    def test_supported_retained_continuation_is_used(self):
+        p=SupportedArrivalPreference('unsupported',
+            {'unsupported':(1,), 'supported':(2,), 'delay':(3,)},
+            {'unsupported':1,'supported':2})
+        keep,audit=p.mask(['unsupported','supported','delay'],np.array([False,True,True]),np.array([.95,.9,.9]))
+        self.assertEqual(keep.tolist(),[False,True,False])
+        self.assertEqual(audit['incumbent'],'supported')
+
+    def test_no_supported_continuation_never_forces_a_plan(self):
+        p=SupportedArrivalPreference('unsupported',{'unsupported':(1,),'fresh':(3,)},{'unsupported':1})
+        keep,audit=p.mask(['unsupported','fresh'],np.array([False,True]),np.array([1.,.9]))
+        self.assertEqual(keep.tolist(),[False,True]);self.assertFalse(audit['active'])
+
+    def test_better_purpose_unknown_and_earlier_arrival_remain_available(self):
+        p=SupportedArrivalPreference('old',{'old':(2,),'better':(3,),'unknown':(None,),'earlier':(1,)},{'old':2})
+        keep,_=p.mask(['old','better','unknown','earlier'],np.ones(4,dtype=bool),np.array([.9,.91,.9,.9]))
+        self.assertTrue(keep.all())
+
+
+if __name__=='__main__':unittest.main()
