+            raise ValueError('represented retained continuations required')
+        if any(type(t) is not int or not 1<=t<=forecast.horizon for t in self.latest.values()):
+            raise ValueError('bounded latest arrival required')
+        if any(len(self.arrivals[k])!=1 or self.arrivals[k][0] is None or self.arrivals[k][0]>t
+               for k,t in self.latest.items()):
+            raise ValueError('consistent earliest/latest arrival bounds required')
