+                or digest([binding_context['personality'], binding_context['values']])
+                != digest([actor.personality, actor.values])):
+            raise ValueError('same factual owner and fixed preferences required')
+        if actor.last_tick >= 0:
+            self.milestone.intention.last_tick = actor.last_tick
+            self.milestone.intention.target = self.options['target']
+            self.milestone.intention.unit = 'owner-decisions'
+        self._pending_capture = None
+
+    def _checkpoint_extension(self):
+        return dict(kind='research-preparation-owner-v1', recovery_cache=self.recovery_cache,
+                    sequence_depth=3, keep_intention=self.keep_intention)
+
+    def _with_actor(self, actor):
+        return PreparationOwner(actor, binding_context=self.binding_context,
+            keep_intention=self.keep_intention,
+            **{k:self.options[k] for k in ('observe','events','terminal','assess','request_for',
+                'feedback','model_id','target','cumulative_preference','seeds')},
+            horizon=self.options['tail_steps']+1, recovery_cache=self.recovery_cache)
+
