+            unit='owner-decisions',horizon=min(16,horizon)) if self.keep_intention else ()
+        options={k:self.options[k] for k in ('observe','events','terminal','assess','request_for',
+            'feedback','model_id','target','seeds','world_model','purpose_estimator',
