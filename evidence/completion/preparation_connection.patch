+"""Known long mechanism regression for the combined, unadopted owner."""
+import copy,json,os,time
+from pathlib import Path
+from concurrent.futures import ProcessPoolExecutor,as_completed
+from reflex.core import digest,character_key
+from reflex.decision_loop import DecisionLoop
+from reflex.model_observer import resolve_feedback
+from tools.run_owned_value import cumulative_basis
+from probe import PublicSequence
+from preparation_owner import PreparationOwner
+
+def build(game,keep=True):
+    world=game.start();actor=game.actor(game.context(world),learning='segmented')
+    return PreparationOwner(actor,binding_context=game.context(world),keep_intention=keep,
+        observe=game.context,events=game.events,terminal=game.terminal,assess=lambda w:game.goal(w).record(),
+        request_for=game.request,feedback=game.feedback,model_id=game.model_id,target=game.target,
+        cumulative_preference=cumulative_basis(game,True),seeds=(701,))
+
+def forced(game,actor,world,action):
+    result=DecisionLoop.decide_batch([(actor,game.request(game.context(world,actor.state)))],False,
+        _counterfactual_roots=(action,))[0]
+    after,flow=game.transition(world,action,'0')
+    resolve_feedback(actor,result['ticket'],game.feedback(world,after,action,result['context'],flow))
+    return after
+
+def game_for(spec):
+    game=PublicSequence(spec['length'],spec['profile']);game.turns=spec['turns']
+    game.model_id=digest([game.model_id,'integrated-public-sequence',spec])
+    return game
+
+def actual_after(game,world,action,spec):
+    after,flow=game.transition(world,action,'0')
+    if spec.get('repriced') and after['tick']==1:after['payout']=2.
+    return after,flow
+
+def run(spec):
+    directory=Path('/content/output/runs')/spec['id'];directory.mkdir(parents=True,exist_ok=True)
+    game=game_for(spec);world=game.start();owner=build(game);template=build(game)
+    initial=world['cash'];axes=character_key(game.context(world));trace=[];started=time.monotonic()
+    while not game.terminal(world):
+        before=owner.actor.record();previous=owner.milestone.record();detached=copy.deepcopy(owner.actor)
+        result=owner.decide(world);key=result['decision']['action_id']
+        after,flow=actual_after(game,world,key,spec)
+        owner.resolve(result['ticket'],game.feedback(world,after,key,result['context'],flow),after)
+        physical=forced(game,detached,world,key)
+        if spec.get('repriced') and physical['tick']==1:physical['payout']=2.
+        assert detached.record()==owner.actor.record() and physical==after
+        assert character_key(game.context(after))==axes
+        snapshot=json.loads(json.dumps(owner.checkpoint(after),allow_nan=False))
+        restored=template.restored(after,snapshot)
+        assert restored.checkpoint(after)==snapshot
+        proposal=owner.last['forecast'].audit['plans'][result['deliberation']['selected_plan']]['proposal']
+        trace.append(dict(tick=world['tick'],before=world,after=after,action=key,
+            before_owner=digest(before),owner=digest(owner.actor.record()),
+            previous_intention=previous,intention=owner.milestone.record(),
+            continuity=result['deliberation'].get('continuity'),subjective_regret=result['deliberation']['subjective_regret'],
+            selected_policy=owner.last['forecast'].audit['continuation_portfolio']['policies'][proposal],
+            goal=game.goal(after).value))
+        owner=restored;world=after
+        payload=dict(spec=spec,world=world,controller=snapshot,trace=trace,
+            elapsed=time.monotonic()-started,complete=game.terminal(world))
+        temp=directory/'checkpoint.new';temp.write_text(json.dumps(dict(payload=payload,sha256=digest(payload)),sort_keys=True));temp.replace(directory/'checkpoint.json')
+    # Replay every factual action/observation independently from the initial owner.
+    replay=build(game).actor;present=game.start()
+    for row in trace:
+        assert present==row['before'] and digest(replay.record())==row['before_owner']
+        present=forced(game,replay,present,row['action'])
+        if spec.get('repriced') and present['tick']==1:present['payout']=2.
+        assert present==row['after'] and digest(replay.record())==row['owner']
+    assert len(trace)==spec['turns'] and replay.record()==owner.actor.record()
+    result=dict(complete=True,spec=spec,trace=trace,final=world,gain=world['cash']-initial,
+        score=game.goal(world).value,replayed_actual_steps=len(trace),controller=owner.checkpoint(world),
+        seconds=time.monotonic()-started,adoption=False)
+    (directory/'result.json').write_text(json.dumps(result,sort_keys=True))
+    return dict(id=spec['id'],complete=True,steps=len(trace),gain=result['gain'],score=result['score'])
+
+def main():
+    plan=json.loads(Path('integration-plan.json').read_bytes());errors=[];rows=[]
+    with ProcessPoolExecutor(max_workers=8) as pool:
+        jobs={pool.submit(run,s):s['id'] for s in plan['specs']}
+        for job in as_completed(jobs):
+            try:rows.append(job.result())
+            except Exception as error:errors.append(dict(id=jobs[job],error=repr(error)))
+            Path('/content/output/progress.json').write_text(json.dumps(dict(completed=rows,errors=errors)))
+    if errors:raise RuntimeError(errors)
+    assert len(rows)==len(plan['specs'])
+    Path('/content/output/summary.json').write_text(json.dumps(dict(complete=True,rows=rows,adoption=False)))
+
+if __name__=='__main__':main()
